# 敏感信息配置示例（复制为 secrets.yaml 后填入真实值）
# ★ secrets.yaml 不入库（.gitignore 已排除），含 API_KEY 等敏感信息
#
# AI 提供方配置：支持多个 OpenAI 兼容服务
# type 取值：
#   - local：本地占位实现（离线兜底，无需 API_KEY）
#   - openai-compatible：OpenAI 兼容 HTTP 服务（DeepSeek/OpenAI/GLM/Qwen/vLLM 等）

ai_providers:
  - name: local-klee
    type: local
    description: 本地占位实现（离线兜底）
    enabled: true

  - name: python-agent
    type: python-agent
    description: Python Agent（记忆 + 流式工具调用；使用下方第一个启用的 openai-compatible 模型）
    enabled: true

  - name: deepseek
    type: openai-compatible
    base_url: https://api.deepseek.com/v1
    api_key: sk-在此填入你的-deepseek-key
    model: deepseek-chat
    description: DeepSeek 在线对话（支持工具调用）
    enabled: false

  - name: openai
    type: openai-compatible
    base_url: https://api.openai.com/v1
    api_key: sk-在此填入你的-openai-key
    model: gpt-4o-mini
    description: OpenAI 官方 API
    enabled: false

# MCP 服务器配置
# type 取值：
#   - local：本进程内的 MCP 服务器（如 LocalTodoMcpServer）
#   - stdio：通过子进程 stdio 通信（暂留接口，后续实现）
#   - sse：通过 HTTP SSE 通信（暂留接口，后续实现）
mcp_servers:
  - name: local-todo
    type: local
    enabled: true

  # 示例：stdio 类型的 MCP 服务器（暂未实现客户端，预留配置）
  - name: weather
    type: stdio
    command: python
    args:
      - "-m"
      - "weather_mcp_server"
    enabled: false

  # 示例：sse 类型的 MCP 服务器（暂未实现客户端，预留配置）
  - name: remote-search
    type: sse
    url: http://localhost:8080/sse
    enabled: false

# Python Agent sidecar 配置
# 不在此处存放模型密钥：sidecar 复用上面第一个启用的 openai-compatible 提供方配置
agent:
  enabled: true                 # 总开关（false 时回退到纯 C# 链路）
  auto_start: true              # 登录后自动拉起 sidecar
  python_path: ""               # 空=自动探测 <项目根>/.venv
  workspace_root: ""            # 空=<用户目录>/agent_workspace
  max_tool_iterations: 8
  request_timeout_seconds: 120
  enable_exec: false            # 命令执行工具默认关闭
  log_level: INFO
  brave_api_key: ""             # 可选：网页搜索用
