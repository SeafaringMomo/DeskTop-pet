# ===== 构建产物 =====
bin/
obj/
publish/
*.user
*.suo
*.userosscache
*.sln.docstates
TestResults/
*.trx
[Cc]overage/

# ===== 用户数据（运行时生成，不入库）=====
# 日志、待办数据库、用户档案、对话记录
user_data/

# ===== 敏感配置（含 API_KEY，不入库）=====
# 提供 secrets.yaml.example 作为模板
config/secrets.yaml
*.secrets.yaml
.env
.env.*

# ===== 静态资源 =====
# 角色目录 static/<角色>/ 下的帧图与媒体默认不入库；
# 默认角色素材随仓库保留（! 取反），用户新增的角色素材由用户自行决定是否提交。
static/**/*.mp3
static/**/*.wav
static/**/*.ogg
static/**/*.png
!static/default_role/**/*.png
!static/default_role/theme.yaml

# ===== IDE =====
.vs/
.idea/
.vscode/
*.swp
*.swo

# ===== 系统 =====
.DS_Store
Thumbs.db
desktop.ini
*.log
