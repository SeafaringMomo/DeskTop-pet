<Window x:Class="DesktopPetCSharp.Windows.ChatHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="对话历史"
        Width="460" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border x:Name="RootBorder" CornerRadius="10"
            BorderBrush="#F5D547" BorderThickness="2"
            Background="#F23D2817" Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Margin="0,0,0,6"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F5D547" Offset="0"/>
                        <GradientStop Color="#E74C3C" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TitleText" Text="📜 对话历史"
                           Foreground="#3D2817"
                           FontFamily="Microsoft YaHei UI" FontWeight="Bold"
                           FontSize="14" Margin="8,4" />
                <Button Grid.Column="1" x:Name="CloseButton" Content="✕"
                        Width="24" Height="24" Margin="2,1"
                        Background="Transparent" Foreground="#3D2817"
                        BorderBrush="#3D2817" BorderThickness="1"
                        FontFamily="Microsoft YaHei UI" FontSize="12"
                        Click="CloseButton_Click" />
            </Grid>

            <!-- 会话列表 -->
            <Border Grid.Row="1" CornerRadius="6" Background="#F25C3A1E" Padding="4" Margin="0,0,0,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="── 历史会话 ──"
                               Foreground="#F5D547"
                               FontFamily="Microsoft YaHei UI" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,2" />
                    <ListBox Grid.Row="1" x:Name="SessionList"
                             Background="Transparent" Foreground="#FFF3D9"
                             BorderThickness="0"
                             FontFamily="Microsoft YaHei UI" FontSize="12"
                             SelectionChanged="SessionList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                    <TextBlock FontSize="10" Opacity="0.7"
                                               Text="{Binding DisplayTime, Mode=OneWay, StringFormat={}{0}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 消息列表（选中会话的消息） -->
            <Border Grid.Row="2" CornerRadius="6" Background="#F25C3A1E" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="── 消息内容 ──"
                               Foreground="#F5D547"
                               FontFamily="Microsoft YaHei UI" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,2" />
                    <TextBox Grid.Row="1" x:Name="MessageView"
                             Background="Transparent" Foreground="#FFF3D9"
                             BorderThickness="0"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             FontFamily="Microsoft YaHei UI" FontSize="12" />
                </Grid>
            </Border>

            <!-- 底部操作 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button x:Name="LoadButton" Content="加载到聊天窗" Width="100" Height="28" Margin="0,0,6,0"
                        Background="#F5D547" Foreground="#3D2817"
                        BorderBrush="#3D2817" BorderThickness="1" FontWeight="Bold"
                        Click="LoadButton_Click" />
                <Button x:Name="DeleteButton" Content="删除选中" Width="80" Height="28" Margin="0,0,6,0"
                        Background="#E74C3C" Foreground="#FFF3D9"
                        BorderBrush="#3D2817" BorderThickness="1"
                        Click="DeleteButton_Click" />
                <Button Content="关闭" Width="72" Height="28"
                        Background="#5C3A1E" Foreground="#FFF3D9"
                        BorderBrush="#F5D547" BorderThickness="1"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
