<Window x:Class="DesktopPetCSharp.Windows.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopPet"
        Width="120" Height="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">
    <Grid>
        <!-- 像素风渲染：NearestNeighbor 保证硬边像素，不模糊；
             RenderTransformOrigin 设在底部中央，让"呼吸"缩放看起来像身体起伏。 -->
        <Image x:Name="PetImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderOptions.EdgeMode="Aliased"
               RenderTransformOrigin="0.5,1.0">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BreathScale" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="PetRotate" Angle="0" />
                    <TranslateTransform x:Name="BobTranslate" X="0" Y="0" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <!-- 粒子层：覆盖在 PetImage 上方，用于显示爱心/汗滴/✨ 等粒子效果。
             不接收鼠标事件，避免阻挡宠物拖拽与点击。 -->
        <Canvas x:Name="ParticleLayer"
                IsHitTestVisible="False"
                ClipToBounds="False" />
    </Grid>
</Window>
