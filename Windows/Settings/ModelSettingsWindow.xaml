<Window x:Class="DesktopPetCSharp.Windows.ModelSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型设置"
        Width="460" Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <!-- 外边框：圆角 + 主色边框。ApplyTheme 会改 BorderBrush/Background -->
    <Border x:Name="RootBorder" CornerRadius="10"
            BorderBrush="#F5D547"
            BorderThickness="2"
            Background="#F23D2817"
            Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Margin="0,0,0,8"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F5D547" Offset="0"/>
                        <GradientStop Color="#E74C3C" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TitleText" Text="⚙ 模型设置"
                           Foreground="#3D2817"
                           FontFamily="Microsoft YaHei UI" FontWeight="Bold"
                           FontSize="14" Margin="10,5" />
                <Button Grid.Column="1" x:Name="CloseButton" Content="✕"
                        Width="24" Height="24" Margin="2,1"
                        Background="Transparent" Foreground="#3D2817"
                        BorderBrush="#3D2817" BorderThickness="1"
                        FontFamily="Microsoft YaHei UI" FontSize="12"
                        Click="CloseButton_Click" />
            </Grid>

            <!-- 当前默认提示 -->
            <TextBlock Grid.Row="1" x:Name="CurrentLabel" Margin="0,0,0,6"
                       Foreground="#FFF3D9" FontFamily="Microsoft YaHei UI" FontSize="12"
                       Text="当前默认提供方：" />

            <!-- 提供方列表 -->
            <Border Grid.Row="2" CornerRadius="6" Background="#F25C3A1E" Padding="4">
                <ListBox x:Name="ProviderList"
                         Background="Transparent"
                         Foreground="#FFF3D9"
                         BorderThickness="0"
                         FontFamily="Microsoft YaHei UI" FontSize="13">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock FontWeight="Bold" Text="{Binding DisplayName}" />
                                <TextBlock FontSize="11" Opacity="0.8"
                                           Text="{Binding Description}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 底部操作 -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="AddButton" Content="➕ 新增"
                        Width="68" Height="28" Margin="0,0,4,0"
                        Background="#5C3A1E" Foreground="#FFF3D9"
                        BorderBrush="#F5D547" BorderThickness="1"
                        FontFamily="Microsoft YaHei UI" FontSize="11"
                        Click="AddButton_Click"
                        ToolTip="新增 AI 提供方" />
                <Button Grid.Column="1" x:Name="EditButton" Content="✏ 编辑"
                        Width="68" Height="28" Margin="0,0,4,0"
                        Background="#5C3A1E" Foreground="#FFF3D9"
                        BorderBrush="#F5D547" BorderThickness="1"
                        FontFamily="Microsoft YaHei UI" FontSize="11"
                        Click="EditButton_Click"
                        ToolTip="编辑选中的 AI 提供方" />
                <Button Grid.Column="2" x:Name="DeleteButton" Content="🗑 删除"
                        Width="68" Height="28" Margin="0,0,8,0"
                        Background="#E74C3C" Foreground="#FFF3D9"
                        BorderBrush="#3D2817" BorderThickness="1"
                        FontFamily="Microsoft YaHei UI" FontSize="11"
                        Click="DeleteButton_Click"
                        ToolTip="删除选中的 AI 提供方" />
                <Button Grid.Column="4" x:Name="ApplyButton" Content="应用"
                        Width="68" Height="28" Margin="0,0,4,0"
                        Background="#F5D547" Foreground="#3D2817"
                        BorderBrush="#3D2817" BorderThickness="1" FontWeight="Bold"
                        Click="ApplyButton_Click"
                        ToolTip="切换为当前默认" />
                <Button Grid.Column="5" Content="关闭"
                        Width="68" Height="28"
                        Background="#5C3A1E" Foreground="#FFF3D9"
                        BorderBrush="#F5D547" BorderThickness="1"
                        Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
