<Window x:Class="DesktopPetCSharp.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="480" Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border x:Name="RootBorder" CornerRadius="10"
            BorderBrush="#F5D547"
            BorderThickness="2"
            Background="#F23D2817"
            Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Margin="0,0,0,8"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F5D547" Offset="0"/>
                        <GradientStop Color="#E74C3C" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TitleText" Text="⚙ 设置"
                           Foreground="#3D2817"
                           FontFamily="Microsoft YaHei UI" FontWeight="Bold"
                           FontSize="14" Margin="10,5" />
                <Button Grid.Column="1" x:Name="CloseButton" Content="✕"
                        Width="24" Height="24" Margin="2,1"
                        Background="Transparent" Foreground="#3D2817"
                        BorderBrush="#3D2817" BorderThickness="1"
                        FontFamily="Microsoft YaHei UI" FontSize="12"
                        Click="CloseButton_Click" />
            </Grid>

            <!-- 通用设置 -->
            <TextBlock Grid.Row="1" Text="通用设置"
                       Foreground="#FFF3D9" FontFamily="Microsoft YaHei UI"
                       FontWeight="Bold" FontSize="13" Margin="0,4,0,4" />

            <CheckBox Grid.Row="2" x:Name="AutoStartCheckBox"
                      Content="开机自动启动桌面宠物"
                      Foreground="#FFF3D9"
                      FontFamily="Microsoft YaHei UI" FontSize="12"
                      Margin="10,2" Click="AutoStartCheckBox_Click" />

            <!-- 数据管理 -->
            <TextBlock Grid.Row="3" Text="数据管理"
                       Foreground="#FFF3D9" FontFamily="Microsoft YaHei UI"
                       FontWeight="Bold" FontSize="13" Margin="0,12,0,4" />

            <StackPanel Grid.Row="4" Margin="10,4">
                <TextBlock x:Name="UserInfoLabel" Text="当前用户：-"
                           Foreground="#FFF3D9" FontFamily="Microsoft YaHei UI"
                           FontSize="11" Opacity="0.8" Margin="0,0,0,8" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="ExportButton" Content="📤 导出当前用户档案"
                            Height="32"
                            Background="#5C3A1E" Foreground="#FFF3D9"
                            BorderBrush="#F5D547" BorderThickness="1"
                            FontFamily="Microsoft YaHei UI" FontSize="12"
                            Click="ExportButton_Click"
                            ToolTip="把当前用户的 profile.yaml + todo.db + chat_history.db 打包为 ZIP" />
                    <Button Grid.Column="2" x:Name="ImportButton" Content="📥 导入用户档案"
                            Height="32"
                            Background="#5C3A1E" Foreground="#FFF3D9"
                            BorderBrush="#F5D547" BorderThickness="1"
                            FontFamily="Microsoft YaHei UI" FontSize="12"
                            Click="ImportButton_Click"
                            ToolTip="从 ZIP 文件导入用户档案（导入前会备份现有数据）" />
                </Grid>

                <Button x:Name="OpenUserDirButton" Content="📂 打开用户数据目录"
                        Height="32" Margin="0,4,0,0"
                        Background="#5C3A1E" Foreground="#FFF3D9"
                        BorderBrush="#F5D547" BorderThickness="1"
                        FontFamily="Microsoft YaHei UI" FontSize="12"
                        Click="OpenUserDirButton_Click"
                        ToolTip="在文件资源管理器中打开 user_data/users/&lt;name&gt;/" />
            </StackPanel>

            <!-- 底部关闭按钮 -->
            <Grid Grid.Row="5" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="关闭"
                        Width="80" Height="30"
                        Background="#5C3A1E" Foreground="#FFF3D9"
                        BorderBrush="#F5D547" BorderThickness="1"
                        Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
