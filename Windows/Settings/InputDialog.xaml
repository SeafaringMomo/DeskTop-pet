<Window x:Class="DesktopGent.Windows.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Width="360" Height="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border x:Name="RootBorder" CornerRadius="8"
            BorderBrush="#F5D547"
            BorderThickness="2"
            Background="#F23D2817"
            Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" x:Name="TitleBar" Background="#F5D547" CornerRadius="4"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="0,0,0,8">
                <TextBlock x:Name="TitleText" Text="输入"
                           Foreground="#3D2817" FontWeight="Bold"
                           FontFamily="Microsoft YaHei UI" FontSize="12"
                           Margin="8,4" />
            </Border>

            <TextBlock Grid.Row="1" x:Name="PromptText" Text=""
                       Foreground="#FFF3D9"
                       FontFamily="Microsoft YaHei UI" FontSize="12"
                       Margin="0,0,0,6" />

            <TextBox Grid.Row="2" x:Name="InputBox"
                     Background="#F25C3A1E"
                     Foreground="#FFF3D9"
                     BorderBrush="#F5D547" BorderThickness="1"
                     FontFamily="Microsoft YaHei UI" FontSize="13"
                     VerticalContentAlignment="Center"
                     Padding="4" />

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" x:Name="OkButton" Content="确定"
                        Width="72" Height="28" Margin="0,0,6,0"
                        Background="#F5D547" Foreground="#3D2817"
                        FontFamily="Microsoft YaHei UI" FontSize="12"
                        Click="OkButton_Click" />
                <Button Grid.Column="2" x:Name="CancelButton" Content="取消"
                        Width="72" Height="28"
                        Background="#5C3A1E" Foreground="#FFF3D9"
                        FontFamily="Microsoft YaHei UI" FontSize="12"
                        Click="CancelButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
