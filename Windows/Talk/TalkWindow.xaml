<Window x:Class="DesktopPetCSharp.Windows.TalkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Talk"
        Width="340" Height="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <!-- 外边框：圆角 + 主色边框。ApplyTheme 会改 BorderBrush/Background -->
    <Border x:Name="RootBorder"
            CornerRadius="10"
            BorderBrush="#F5D547"
            BorderThickness="2"
            Background="#F23D2817"
            Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏：主色渐变背景，可拖动，右侧两个按钮（模型设置/关闭） -->
            <Grid Grid.Row="0" x:Name="TitleBar" Margin="0,0,0,6"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F5D547" Offset="0"/>
                        <GradientStop Color="#E74C3C" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TitleText" Text="💬 聊天"
                           Foreground="#3D2817"
                           FontFamily="Microsoft YaHei UI" FontWeight="Bold"
                           FontSize="14" Margin="8,4" />
                <Button Grid.Column="1" x:Name="HistoryButton" Content="📜 历史"
                        Width="56" Height="24" Margin="2,1"
                        Background="Transparent" Foreground="#3D2817"
                        BorderBrush="#3D2817" BorderThickness="1"
                        FontFamily="Microsoft YaHei UI" FontSize="11"
                        Click="HistoryButton_Click"
                        ToolTip="查看历史对话记录" />
                <Button Grid.Column="2" x:Name="ModelSettingsButton" Content="⚙ 模型"
                        Width="56" Height="24" Margin="2,1"
                        Background="Transparent" Foreground="#3D2817"
                        BorderBrush="#3D2817" BorderThickness="1"
                        FontFamily="Microsoft YaHei UI" FontSize="11"
                        Click="ModelSettingsButton_Click"
                        ToolTip="切换 AI 模型提供方" />
                <Button Grid.Column="3" x:Name="CloseButton" Content="✕"
                        Width="24" Height="24" Margin="2,1"
                        Background="Transparent" Foreground="#3D2817"
                        BorderBrush="#3D2817" BorderThickness="1"
                        FontFamily="Microsoft YaHei UI" FontSize="12"
                        Click="CloseButton_Click"
                        ToolTip="关闭聊天窗" />
            </Grid>

            <!-- 输出区：表面色背景，主色文字，圆角，只读，自动滚动 -->
            <Border Grid.Row="1" CornerRadius="6" Background="#F25C3A1E" Padding="4">
                <TextBox x:Name="OutputBox"
                         Background="Transparent"
                         Foreground="#FFF3D9"
                         BorderThickness="0"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="13"
                         CaretBrush="#F5D547" />
            </Border>

            <!-- 输入区：输入框 + 麦克风按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                <TextBox x:Name="InputBox"
                         Width="282" Height="30"
                         Background="#F25C3A1E"
                         Foreground="#FFF3D9"
                         BorderBrush="#F5D547"
                         BorderThickness="1"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="13"
                         CaretBrush="#F5D547"
                         KeyDown="InputBox_KeyDown" />
                <Button x:Name="MicButton" Content="🎤"
                        Width="36" Height="30" Margin="6,0,0,0"
                        Background="#F25C3A1E" Foreground="#F5D547"
                        BorderBrush="#F5D547" BorderThickness="1"
                        FontFamily="Segoe UI Emoji" FontSize="14"
                        Click="MicButton_Click"
                        ToolTip="点击开始语音输入，再次点击停止" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
