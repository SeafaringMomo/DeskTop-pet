<Window x:Class="DesktopGent.Windows.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办"
        Width="380" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <!-- 外边框：圆角 + 主色边框。ApplyTheme 会改 BorderBrush/Background -->
    <Border x:Name="RootBorder"
            CornerRadius="10"
            BorderBrush="#F5D547"
            BorderThickness="2"
            Background="#F23D2817"
            Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏：主色渐变背景，可拖拽 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Margin="0,0,0,8"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F5D547" Offset="0"/>
                        <GradientStop Color="#E74C3C" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Grid.Column="0" Text="📋 待办本"
                           Foreground="#3D2817"
                           FontFamily="Microsoft YaHei UI" FontWeight="Bold"
                           FontSize="14" Margin="10,5" />
                <Button Grid.Column="1" x:Name="CloseButton" Content="✕"
                        Width="24" Height="24" Margin="2,1"
                        Background="Transparent" Foreground="#3D2817"
                        BorderBrush="#3D2817" BorderThickness="1"
                        FontFamily="Microsoft YaHei UI" FontSize="12"
                        Click="CloseButton_Click" />
            </Grid>

            <!-- 输入区 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,6">
                <TextBox x:Name="TaskInput"
                         Width="236" Height="30"
                         Background="#F25C3A1E"
                         Foreground="#FFF3D9"
                         BorderBrush="#F5D547" BorderThickness="1"
                         FontFamily="Microsoft YaHei UI" FontSize="13"
                         CaretBrush="#F5D547"
                         KeyDown="TaskInput_KeyDown" />
                <Button x:Name="MicButton" Content="🎤"
                        Width="36" Height="30" Margin="6,0,0,0"
                        Background="#F25C3A1E" Foreground="#F5D547"
                        BorderBrush="#F5D547" BorderThickness="1"
                        FontFamily="Segoe UI Emoji" FontSize="14"
                        Click="MicButton_Click"
                        ToolTip="点击开始语音输入，再次点击停止" />
                <Button x:Name="AddButton" Content="添加" Width="56" Height="30" Margin="6,0,0,0"
                        Background="#F5D547" Foreground="#3D2817"
                        BorderBrush="#3D2817" BorderThickness="1"
                        FontWeight="Bold"
                        Click="AddButton_Click" />
            </StackPanel>

            <!-- 列表区 -->
            <Border Grid.Row="2" CornerRadius="6" Background="#F25C3A1E" Padding="4">
                <ListBox x:Name="TaskList"
                         Background="Transparent"
                         Foreground="#FFF3D9"
                         BorderThickness="0"
                         FontFamily="Microsoft YaHei UI" FontSize="13"
                         MouseDoubleClick="TaskList_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding IsDoneDisplay}" Width="22"
                                           Foreground="#F5D547" FontWeight="Bold" />
                                <TextBlock Text="{Binding Content}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 底部操作 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="DeleteButton" Content="删除选中" Width="80" Height="26" Margin="0,0,8,0"
                        Background="#E74C3C" Foreground="#FFF3D9"
                        BorderBrush="#3D2817" BorderThickness="1"
                        Click="DeleteButton_Click" />
                <Button x:Name="ClearDoneButton" Content="清除已完成" Width="92" Height="26"
                        Background="#5C3A1E" Foreground="#FFF3D9"
                        BorderBrush="#F5D547" BorderThickness="1"
                        Click="ClearDoneButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
