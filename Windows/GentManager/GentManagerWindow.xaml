<Window x:Class="DesktopGent.Windows.GentManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理"
        Width="560" Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border x:Name="RootBorder" CornerRadius="10"
            BorderBrush="#F5D547" BorderThickness="2"
            Background="#F23D2817" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Margin="0,0,0,6"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F5D547" Offset="0"/>
                        <GradientStop Color="#E74C3C" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TitleText" Text="管理"
                           Foreground="#3D2817"
                           FontFamily="Microsoft YaHei UI" FontWeight="Bold"
                           FontSize="14" Margin="10,5" />
                <Button Grid.Column="1" x:Name="CloseButton" Content="✕"
                        Width="24" Height="24" Margin="2,1"
                        Background="Transparent" Foreground="#3D2817"
                        BorderBrush="#3D2817" BorderThickness="1"
                        FontFamily="Microsoft YaHei UI" FontSize="12"
                        Click="CloseButton_Click" />
            </Grid>

            <!-- 顶部 Tab 切换 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="TabShop" Content="🛒 商店" Width="90" Height="30" Margin="0,0,4,0"
                        Background="#F5D547" Foreground="#3D2817"
                        BorderBrush="#3D2817" BorderThickness="1" FontWeight="Bold"
                        FontFamily="Microsoft YaHei UI" FontSize="12"
                        Click="TabShop_Click" />
                <Button x:Name="TabInteract" Content="🤝 互动" Width="90" Height="30" Margin="0,0,4,0"
                        Background="#5C3A1E" Foreground="#FFF3D9"
                        BorderBrush="#F5D547" BorderThickness="1"
                        FontFamily="Microsoft YaHei UI" FontSize="12"
                        Click="TabInteract_Click" />
                <Button x:Name="TabFeed" Content="🍖 喂食" Width="90" Height="30" Margin="0,0,4,0"
                        Background="#5C3A1E" Foreground="#FFF3D9"
                        BorderBrush="#F5D547" BorderThickness="1"
                        FontFamily="Microsoft YaHei UI" FontSize="12"
                        Click="TabFeed_Click" />
                <Button x:Name="TabStatus" Content="📊 状态" Width="90" Height="30"
                        Background="#5C3A1E" Foreground="#FFF3D9"
                        BorderBrush="#F5D547" BorderThickness="1"
                        FontFamily="Microsoft YaHei UI" FontSize="12"
                        Click="TabStatus_Click" />
            </StackPanel>

            <!-- 内容区（各 Panel 切换显示） -->
            <Grid Grid.Row="2" x:Name="ContentArea" />
        </Grid>
    </Border>
</Window>
