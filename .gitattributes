# 文本文件统一使用 LF 存储（跨平台一致，避免 CRLF 混乱）
* text=auto eol=lf

*.cs            text eol=lf
*.xaml          text eol=lf
*.csproj        text eol=lf
*.sln           text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.json          text eol=lf
*.gitignore     text eol=lf
*.gitattributes text eol=lf
LICENSE         text eol=lf

# 二进制文件不做转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.exe    binary
*.dll    binary
*.db     binary
